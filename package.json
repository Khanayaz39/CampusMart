{
  "name": "campusmart",
  "version": "1.0.0",
  "description": "CampusMart - AI-Enhanced College Marketplace",
  "scripts": {
    "start": "npm run build && node server/server.js",
    "dev": "npm run build && node server/server.js",
    "build:jsx": "esbuild src/main.jsx --bundle --outfile=public/js/bundle/react-bundle.js --minify",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/tailwind.css --minify",
    "build": "npm run build:jsx && npm run build:css"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "esbuild": "^0.24.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.2",
    "tailwindcss": "^3.4.19"
  }
}
